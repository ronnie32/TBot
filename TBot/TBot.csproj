<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputPath>$(LOCALAPPDATA)\TBot-cache\out\</OutputPath>
    <PublishDir>C:\dev\TBot\bin\</PublishDir>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <SatelliteResourceLanguages></SatelliteResourceLanguages>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Nullable>disable</Nullable>
    <Authors>TBot</Authors>
    <Version>3.5.0.1</Version>
    <StartupObject>Tbot.Program</StartupObject>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <Copyright>2026 © TBot</Copyright>
    <PackageLicenseExpression>https://licenses.nuget.org/MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://www.ogame-tbot.net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/0xE232FE/TBot</RepositoryUrl>
    <AssemblyVersion>3.5.0.1</AssemblyVersion>
    <FileVersion>3.5.0.1</FileVersion>
    <Description>OGame Bot</Description>
    <SignAssembly>False</SignAssembly>
    <AssemblyOriginatorKeyFile>ELK-Lab.pfx</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
    <RootNamespace>Tbot</RootNamespace>
    <PackageReleaseNotes></PackageReleaseNotes>
    <Configurations>Debug;Release</Configurations>
    <ApplicationIcon>tbot.ico</ApplicationIcon>
    <PackageIcon></PackageIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x86'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="tbot.ico" />
    <Content Include="profiles\**">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\README.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <TargetPath>README.md</TargetPath>
    </Content>
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
	<PackageReference Include="Microsoft.Extensions.FileProviders.Physical" Version="9.0.8" />
	<PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.8" />
	<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="Telegram.Bot" Version="22.6.2" />
    <PackageReference Include="Telegram.Bot.Extensions.Polling" Version="1.0.2" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="instance_settings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="settings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="profiles\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TBot.Ogame.Infrastructure\TBot.Ogame.Infrastructure.csproj" />
    <ProjectReference Include="..\TBot.WebUI\TBot.WebUI.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <StaticWebAssetBasePath>wwwroot\</StaticWebAssetBasePath>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>C:\dev\TBot\bin\</PublishDir>
  </PropertyGroup>

  <Target Name="RemoveRefsFolder" AfterTargets="Build;Publish">
    <RemoveDir Directories="$(OutputPath)refs" Condition="Exists('$(OutputPath)refs')" />
    <RemoveDir Directories="$(PublishDir)refs" Condition="Exists('$(PublishDir)refs')" />
  </Target>

  <!-- Pulled in automatically as Content by the TBot.WebUI project reference; TBot never runs
       with ASPNETCORE_ENVIRONMENT=Development, so it's dead weight in the deployed folder. -->
  <Target Name="RemoveDevAppsettings" AfterTargets="Build;Publish">
    <Delete Files="$(OutputPath)appsettings.Development.json" Condition="Exists('$(OutputPath)appsettings.Development.json')" />
    <Delete Files="$(PublishDir)appsettings.Development.json" Condition="Exists('$(PublishDir)appsettings.Development.json')" />
  </Target>

  <!-- IIS in-process hosting module, pulled in by the ASP.NET Core SDK; TBot.WebUI only ever
       runs via Kestrel, never behind IIS, so this is dead weight. -->
  <Target Name="RemoveIISModule" AfterTargets="Build;Publish">
    <Delete Files="$(OutputPath)aspnetcorev2_inprocess.dll" Condition="Exists('$(OutputPath)aspnetcorev2_inprocess.dll')" />
    <Delete Files="$(PublishDir)aspnetcorev2_inprocess.dll" Condition="Exists('$(PublishDir)aspnetcorev2_inprocess.dll')" />
  </Target>

  <Target Name="RemoveStaticWebAssets" AfterTargets="Build;Publish">
    <ItemGroup>
      <_StaticWebAssets Remove="$(OutputPath)TBot.WebUI.staticwebassets.*" />
    </ItemGroup>
    <Delete Files="$(OutputPath)TBot.WebUI.staticwebassets.endpoints.json" Condition="Exists('$(OutputPath)TBot.WebUI.staticwebassets.endpoints.json')" />
    <Delete Files="$(OutputPath)TBot.WebUI.staticwebassets.runtime.json" Condition="Exists('$(OutputPath)TBot.WebUI.staticwebassets.runtime.json')" />
  </Target>

</Project>
